# desc: GNU Radio + RTL-SDR, with gr-lora_sdr for LoRa/Meshtastic/MeshCore
# GNU Radio + RTL-SDR. gnuradio/gr-osmosdr are the distro copies (GRC, CLI tools);
# the LoRa/Meshtastic blocks live in the conda env built by docker/gnuradio.Dockerfile,
# which also needs the toolchain and the librtlsdr/libusb headers listed here.
gnuradio gr-osmosdr rtl-sdr librtlsdr-dev usbutils
libusb-1.0-0-dev libgtk-3-dev python3-gi gir1.2-gtk-3.0
build-essential cmake git wget unzip pkg-config
