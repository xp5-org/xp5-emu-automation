# desc: SIMH historical computer simulators (dgnova/Nova etc.), built from git
# Build deps for docker/simh.Dockerfile (github.com/simh/simh); the -dev packages
# double as the runtime libs (pcap networking, VDE, SDL2 video, PNG screenshots).
build-essential git make
libpcap-dev libvdeplug-dev libsdl2-dev libsdl2-ttf-dev libpng-dev zlib1g-dev libedit-dev libpcre2-dev
