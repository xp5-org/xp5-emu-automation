# desc: EDA tools (Icarus Verilog, Yosys, ngspice, GTKWave) built from git, plus sox
# EDA toolchain for sourcedir/eda_mixed_signal (KiCad schematic -> Verilog +
# SDF -> Icarus; ngspice for the analog tier). KiCad itself (kicad-cli and the
# stock symbol libs used to generate schematics) is the separate "kicad"
# component, built from git; select it together with eda.
# The python3-* libs are the SYSTEM interpreter's: the runner's /opt/venv has no
# yaml/scipy/matplotlib, so the eda scripts call /usr/bin/python3 (EDA_PYTHON).
# Build deps for docker/eda.Dockerfile (iverilog, yosys, ngspice, gtkwave are built
# from git there; the -dev packages double as their runtime libs). sox stays apt.
sox
build-essential cmake git autoconf automake libtool gperf flex bison gawk clang pkg-config
meson ninja-build python3 tcl-dev tk-dev libreadline-dev libffi-dev zlib1g-dev
libbz2-dev liblzma-dev libjudy-dev libgtk-3-dev libgtk-4-dev libjson-glib-dev libgirepository1.0-dev desktop-file-utils
libxaw7-dev libx11-dev libxmu-dev libxft-dev libfftw3-dev
libboost-system-dev libboost-filesystem-dev libboost-python-dev
python3-numpy python3-scipy python3-matplotlib python3-yaml python3-lxml
